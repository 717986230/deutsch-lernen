.page { background: #f7f9fc; min-height: 100vh; }
.container { padding: 0 32rpx 100rpx; }

/* ---- 汇总统计 ---- */
.stat-row { display: flex; gap: 20rpx; margin-bottom: 32rpx; }
.stat-card {
  flex: 1;
  background: #ffffff;
  border: 1rpx solid #e8eaed;
  border-radius: 24rpx;
  padding: 32rpx 0 24rpx;
  text-align: center;
}
.stat-num { font-size: 52rpx; color: #58cc02; font-weight: 700; }
.stat-label { font-size: 24rpx; color: #777777; margin-top: 8rpx; }
.tip { font-size: 26rpx; color: #777777; line-height: 1.8; margin-bottom: 32rpx; }
.empty { text-align: center; padding: 40rpx 0; }
.empty-text { font-size: 26rpx; color: #777777; line-height: 1.8; margin: 24rpx 0 32rpx; }
.done-hint {
  text-align: center;
  font-size: 28rpx;
  color: #58cc02;
  background: rgba(88,204,2,0.08);
  border: 1rpx solid rgba(88,204,2,0.3);
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  line-height: 1.7;
  margin-bottom: 24rpx;
}

/* ---- 按钮 ---- */
.btn-primary {
  text-align: center;
  padding: 28rpx 0;
  border-radius: 28rpx;
  background: #58cc02;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  border-bottom: 6rpx solid #46a302;
}
.btn-primary:active { transform: translateY(4rpx); border-bottom-width: 2rpx; }
.btn-secondary {
  text-align: center;
  padding: 28rpx 0;
  border-radius: 28rpx;
  background: #ffffff;
  color: #3c3c3c;
  font-size: 28rpx;
  border: 1rpx solid #e8eaed;
}

/* ---- 答题卡 ---- */
.progress { font-size: 24rpx; color: #777777; margin-bottom: 12rpx; }
.progress-bar { height: 8rpx; background: #eef1f5; border-radius: 4rpx; margin-bottom: 32rpx; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, #58cc02, #46a302); border-radius: 4rpx; transition: width 0.35s ease; }
.recall-card {
  background: #ffffff;
  border: 1rpx solid #e8eaed;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  box-shadow: 0 6rpx 36rpx rgba(0,0,0,0.08);
}
.recall-zh { font-size: 44rpx; color: #3c3c3c; font-weight: 600; margin-bottom: 16rpx; line-height: 1.5; }
.recall-hint { font-size: 26rpx; color: #777777; margin-bottom: 32rpx; }
.recall-de {
  font-size: 40rpx;
  color: #58cc02;
  font-style: italic;
  font-weight: 700;
  margin: 8rpx 0 16rpx;
  line-height: 1.5;
}
.recall-py { font-size: 24rpx; color: #777777; margin-bottom: 8rpx; }
.recall-meta { font-size: 22rpx; color: rgba(88,204,2,0.65); margin-bottom: 28rpx; }

/* 朗读按钮：88rpx 触摸目标，绿底白字圆钮 */
.speak-btn {
  display: inline-flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  vertical-align: middle;
  margin-left: 12rpx;
}
.speak-btn-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 32rpx;
  color: #ffffff;
  background: #58cc02;
  border-radius: 50%;
}

/* 三档自评 */
.grade-row { display: flex; gap: 16rpx; margin-top: 8rpx; }
.grade-btn {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}
.grade-forgot { background: #ff4b4b; }
.grade-fuzzy { background: #ff9600; }
.grade-known { background: #58cc02; }

/* ---- 完成页 ---- */
.done-box {
  background: #ffffff;
  border: 1rpx solid #e8eaed;
  border-radius: 32rpx;
  padding: 64rpx 40rpx;
  text-align: center;
  box-shadow: 0 6rpx 36rpx rgba(0,0,0,0.08);
}
.done-title { font-size: 36rpx; color: #58cc02; font-weight: 700; margin: 20rpx 0 16rpx; }
.done-text { font-size: 26rpx; color: #777777; line-height: 1.8; margin-bottom: 36rpx; }
