.fav-page {
  min-height: 100vh;
  background: #f7f9fc;
  padding: 32rpx 24rpx;
  box-sizing: border-box;
}

.fav-loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-top: 120rpx;
}

.fav-loading-text {
  font-size: 28rpx;
  color: #777777;
}

.fav-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 160rpx;
  gap: 32rpx;
}

.fav-empty-icon {
  font-size: 80rpx;
  color: rgba(88,204,2,0.4);
}

.fav-empty-text {
  font-size: 28rpx;
  color: #777777;
  text-align: center;
  line-height: 1.8;
}

.fav-header {
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.fav-header-text {
  font-size: 24rpx;
  color: #777777;
}

.fav-add-srs {
  font-size: 24rpx;
  color: #58cc02;
  padding: 12rpx 20rpx;
  border: 1rpx solid rgba(88,204,2,0.4);
  border-radius: 28rpx;
  background: rgba(88,204,2,0.08);
}

/* 加载失败态（与空态分离） */
.fav-error {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 160rpx;
  gap: 24rpx;
}

.fav-error-icon { font-size: 64rpx; }

.fav-error-text {
  font-size: 28rpx;
  color: #777777;
  text-align: center;
}

.fav-retry {
  font-size: 28rpx;
  color: #ffffff;
  background: #58cc02;
  padding: 20rpx 48rpx;
  border-radius: 28rpx;
  font-weight: 700;
}

/* 今日待复习入口卡片 */
.srs-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(145deg, rgba(88,204,2,0.14) 0%, rgba(88,204,2,0.05) 100%);
  border: 1rpx solid rgba(88,204,2,0.4);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.srs-card-left { display: flex; flex-direction: column; gap: 8rpx; }

.srs-card-title { font-size: 30rpx; color: #46a302; font-weight: 700; }

.srs-card-sub { font-size: 24rpx; color: #777777; }

.srs-card-arrow { font-size: 48rpx; color: #58cc02; }

.fav-item {
  margin-bottom: 8rpx;
}

.fav-remove {
  display: flex;
  justify-content: flex-end;
  padding: 8rpx 0 16rpx;
}

.fav-remove-text {
  font-size: 22rpx;
  color: rgba(255,75,75,0.7);
  padding: 8rpx 24rpx;
  border: 1rpx solid rgba(255,75,75,0.3);
  border-radius: 20rpx;
}
