.page { background: #f7f9fc; min-height: 100vh; }
.container { padding: 0 32rpx 100rpx; }
.loading { text-align: center; color: #777777; font-size: 28rpx; padding: 80rpx 0; }

/* ---- 模式选择网格 ---- */
.mode-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.mode-card {
  background: #ffffff;
  border: 1rpx solid #e8eaed;
  border-radius: 28rpx;
  padding: 52rpx 24rpx 44rpx;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.07), inset 0 1rpx 0 rgba(255,255,255,0.6);
  transition: all 0.18s;
}
.mode-card:active {
  transform: scale(0.96);
  background: linear-gradient(145deg, rgba(88,204,2,0.12) 0%, rgba(88,204,2,0.04) 100%);
  border-color: rgba(88,204,2,0.35);
  box-shadow: 0 2rpx 16rpx rgba(88,204,2,0.18), inset 0 1rpx 0 rgba(88,204,2,0.1);
}
.mode-icon {
  font-size: 60rpx;
  margin-bottom: 18rpx;
  display: block;
  filter: drop-shadow(0 2rpx 8rpx rgba(88,204,2,0.25));
}
.mode-title {
  color: #58cc02;
  font-size: 30rpx;
  margin-bottom: 10rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}
.mode-desc { font-size: 24rpx; color: #777777; line-height: 1.5; }
.tip-hint {
  text-align: center;
  color: #777777;
  font-size: 24rpx;
  margin-top: 44rpx;
  opacity: 0.75;
}

/* ---- 出题范围 / 题量选择 ---- */
.quiz-opt-label { font-size: 26rpx; color: #777777; margin: 28rpx 0 16rpx; }
.level-tabs { display: flex; white-space: nowrap; margin-bottom: 8rpx; }
.level-tab {
  display: inline-block;
  padding: 14rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid #e8eaed;
  font-size: 26rpx;
  color: #3c3c3c;
}
.level-tab-active { background: #58cc02; border-color: #58cc02; color: #ffffff; }
.len-row { display: flex; gap: 20rpx; margin-bottom: 28rpx; }
.len-btn {
  padding: 16rpx 36rpx;
  border-radius: 32rpx;
  background: #ffffff;
  border: 1rpx solid #e8eaed;
  font-size: 26rpx;
  color: #3c3c3c;
}
.len-btn-active { background: #58cc02; border-color: #58cc02; color: #ffffff; }

/* ---- 结算页 ---- */
.result-box {
  background: #ffffff;
  border: 1rpx solid #e8eaed;
  border-radius: 32rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  box-shadow: 0 6rpx 36rpx rgba(0,0,0,0.08);
}
.result-score { font-size: 48rpx; color: #58cc02; font-weight: 700; margin: 16rpx 0 8rpx; }
.result-msg { font-size: 26rpx; color: #777777; margin-bottom: 24rpx; }
.result-note { font-size: 24rpx; color: #46a302; line-height: 1.7; margin-bottom: 24rpx; }
.wrong-list { text-align: left; border-top: 1rpx solid #e8eaed; padding-top: 24rpx; }
.wrong-title { font-size: 26rpx; font-weight: 600; color: #3c3c3c; margin-bottom: 16rpx; }
.wrong-item { display: flex; flex-direction: column; margin-bottom: 16rpx; }
.wrong-de { font-size: 28rpx; color: #58cc02; font-style: italic; font-weight: 700; }
.wrong-zh { font-size: 24rpx; color: #777777; }
.quiz-actions { display: flex; gap: 24rpx; justify-content: center; }
.quiz-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 700;
  background: #58cc02;
  color: #ffffff;
}
.quiz-btn--exit { background: #ffffff; color: #777777; border: 1rpx solid #e8eaed; }
